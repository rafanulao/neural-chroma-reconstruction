flowchart LR
    RGB["<b>Source RGB</b><br/>uint8"]:::input --> CODEC["Analytic Li2026 pipeline<br/>transform + 4:2:0 + interpolation"]:::analytic
    CODEC --> BASE["RGB baseline"]:::latent
    CODEC --> KEEP["Retained-site mask"]:::bypass
    BASE --> ADAPT["RGB → model YCrCb"]:::op
    ADAPT --> BACK{"Neural backbone"}:::decision
    BACK --> V6["V6 refiner"]:::trunk
    BACK --> PRISM["Prism refiner<br/>known degradation"]:::trunk
    V6 --> DIFF["Predicted − baseline<br/>chroma"]:::head
    PRISM --> DIFF
    DIFF --> INV["Exact zero-luma<br/>chroma → RGB correction"]:::op
    INV --> MASK["Zero protected pixels<br/>retained sites + optional flat regions"]:::op
    KEEP --> MASK
    BASE -.-> MASK
    MASK --> GAIN["× tanh learned gain<br/>initialized at zero"]:::aux
    BASE --> ADD(("+")):::op
    GAIN --> ADD
    ADD --> OUT["<b>Refined RGB</b><br/>retained sites unchanged"]:::output

